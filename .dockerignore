# Secrets
.env
*.pem
*.key

# Git
.git
.gitignore
.github

# Python
__pycache__
*.py[cod]
.venv
venv
.pytest_cache
*.egg-info

# Không cần khi chạy
tests
screenshots
*.md
Dockerfile*
docker-compose.yml
nginx
.vscode
.idea
